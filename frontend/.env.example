# nhost project (Settings -> General in the nhost dashboard)
NEXT_PUBLIC_NHOST_SUBDOMAIN=your-subdomain
NEXT_PUBLIC_NHOST_REGION=eu-central-1

# Hasura GraphQL endpoint (nhost exposes this too, or run `nhost dev` locally)
NEXT_PUBLIC_HASURA_GRAPHQL_URL=https://your-subdomain.hasura.eu-central-1.nhost.run/v1/graphql
