PORT=4000

# Hasura admin access — server-side only, never shipped to the browser.
HASURA_GRAPHQL_ENDPOINT=https://your-subdomain.hasura.eu-central-1.nhost.run/v1/graphql
HASURA_GRAPHQL_ADMIN_SECRET=your-hasura-admin-secret

# Shared secret Hasura sends back on every Action/cron/event call
# (set the same value as ACTIONS_SECRET in nhost env vars).
ACTIONS_SECRET=change-me

# Optional: real LLM call. Any Groq free-tier key works. If unset,
# llm_call steps run a disclosed stub instead (see functions/_lib/engine.ts).
GROQ_API_KEY=

# Optional: real notify delivery. If unset, notify steps run a disclosed stub.
SLACK_WEBHOOK_URL=
